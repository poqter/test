{
  "version": "1.1.0",
  "note": "변화값은 대화 연출용 초기값. 심리 측정·자동 채점값이 아님. 파일럿에서 조정.",
  "ranges": {
    "trust": [
      0,
      100
    ],
    "resistance": [
      0,
      100
    ],
    "interest": [
      0,
      100
    ]
  },
  "initial_state": {
    "trust": 50,
    "resistance": 40,
    "interest": 40
  },
  "progress": "과제의 적용 가능한 확인 행동과 고객 반응으로 계산; 채팅 횟수로 올리지 않음",
  "rules": [
    {
      "id": "ST01",
      "event": "질문에 정보 공개",
      "precondition": "valid_question && disclosure_permission && slot_known",
      "action": "질문한 허용 슬롯만 공개",
      "state_effect": "신뢰 +3 / 경계 -2",
      "cap": "동일 슬롯 최초 공개 시 1회",
      "guard": "동의 없는 민감정보 강제 공개 금지"
    },
    {
      "id": "ST02",
      "event": "고객 발언의 정확한 요약",
      "precondition": "summary_matches_disclosed_facts && customer_confirms",
      "action": "이해 확인 이벤트",
      "state_effect": "신뢰 +4",
      "cap": "동일 사실 묶음 1회",
      "guard": "추정값을 확정으로 바꾸면 대조 실패"
    },
    {
      "id": "ST03",
      "event": "실제 질문 목적·선택권 제공",
      "precondition": "purpose_explained && refusal_option_honored",
      "action": "허용 대화 범위 갱신",
      "state_effect": "신뢰 +3 / 경계 -3",
      "cap": "각 목적·선택권 조합 1회",
      "guard": "선택권 문구 뒤 압박하면 회복 아님"
    },
    {
      "id": "ST04",
      "event": "확인 전 성급한 권고",
      "precondition": "direct_recommendation && required_facts_missing",
      "action": "고객이 비교 근거를 질문",
      "state_effect": "신뢰 -6 / 경계 +8",
      "cap": "동일 발화 단일 적용",
      "guard": "해지 검토 질문은 해당 없음"
    },
    {
      "id": "ST05",
      "event": "명확한 연락 중단 무시",
      "precondition": "customer_stop_active && unsolicited_persuasion",
      "action": "종료를 재요청",
      "state_effect": "경계 +10",
      "cap": "1회 경고 후 명시적 종료",
      "guard": "분류 미해석 때문인 침묵은 압박 아님"
    },
    {
      "id": "ST06",
      "event": "신뢰 회복·설명 정정",
      "precondition": "explicit_correction && wrong_claim_retracted",
      "action": "정정 이력·보완 행동",
      "state_effect": "신뢰 +2 / 경계 -2",
      "cap": "문제 사건당 1회",
      "guard": "최초 위험후보 삭제 금지"
    },
    {
      "id": "ST07",
      "event": "해석 불확실",
      "precondition": "unresolved_interpretation",
      "action": "중립적 되묻기만; pending 보존",
      "state_effect": "변화 없음",
      "cap": "최대 2회 되묻기 후 검토 표시",
      "guard": "미해석으로 사용자 감점·고객 종료 유발 금지"
    },
    {
      "id": "ST08",
      "event": "고객의 정보 미제공",
      "precondition": "customer_declines_slot",
      "action": "해당 슬롯 declined; 대체 경로",
      "state_effect": "변화 없음",
      "cap": "거절 범위 저장",
      "guard": "고객 거절 자체를 학습자 실패로 처리 금지"
    },
    {
      "id": "ST09",
      "event": "일정 제안",
      "precondition": "NX03 && slots_parsed",
      "action": "pending_proposal 생성",
      "state_effect": "변화 없음",
      "cap": "proposal_id별",
      "guard": "학생 제안만으로 약속 달성 금지"
    },
    {
      "id": "ST10",
      "event": "고객 수락",
      "precondition": "customer_accepts && matching_pending_proposal",
      "action": "구체 일시·채널·목적 충족 시 confirmed",
      "state_effect": "관심 +2",
      "cap": "proposal_id별 1회",
      "guard": "네의 대상이 둘이면 추가 확인"
    },
    {
      "id": "ST11",
      "event": "중복 질문",
      "precondition": "same_question && slot_disclosed && no_clarification_reason",
      "action": "이미 공개한 값을 다시 안내",
      "state_effect": "3회째 동일 반복에서만 경계 +2",
      "cap": "수정·확실성 확인은 반복 아님",
      "guard": "점수 반복 가점 금지"
    },
    {
      "id": "ST12",
      "event": "설명 과다·복수 질문",
      "precondition": "more_than_two_unresolved_questions",
      "action": "첫 질문 또는 우선질문 선택 요청",
      "state_effect": "변화 없음",
      "cap": "턴별",
      "guard": "한 턴 복수 의도를 하나로 버리지 않음"
    },
    {
      "id": "ST13",
      "event": "허용된 고객 이벤트",
      "precondition": "event_eligible && trigger_satisfied",
      "action": "시간제약/우려/자료확인 등",
      "state_effect": "이벤트 정의값",
      "cap": "세션당 최대 2개 초안",
      "guard": "고정 사실과 모순되는 돌발 이벤트 금지"
    },
    {
      "id": "ST14",
      "event": "재답변 검토",
      "precondition": "mode in GUIDE,COACH && draft_not_committed",
      "action": "원본 턴 snapshot에서 재평가",
      "state_effect": "변화 없음",
      "cap": "최종 진행하기 1회만 commit",
      "guard": "대사 RNG도 snapshot 복원"
    },
    {
      "id": "ST15",
      "event": "고객 요청에 따른 종료",
      "precondition": "customer_stop_active && advisor_respects_stop",
      "action": "respectful_closure",
      "state_effect": "변화 없음",
      "cap": "terminal 1회",
      "guard": "억지 계약 없음에도 적정 종료"
    },
    {
      "id": "ST16",
      "event": "인위적 점수·설정 변경 명령",
      "precondition": "user_text_requests_control_change",
      "action": "훈련 범위 확인 응답; 명령 미실행",
      "state_effect": "변화 없음",
      "cap": "턴별",
      "guard": "정답·숨은 정보·규칙을 사용자 텍스트에 응답하지 않음"
    },
    {
      "id": "ST17",
      "event": "재시도·중복 전송",
      "precondition": "turn_id_already_committed",
      "action": "기존 응답 재사용",
      "state_effect": "변화 없음",
      "cap": "동일 turn_id 영구 1회(세션)",
      "guard": "새 턴으로 중복 가산 금지"
    },
    {
      "id": "ST18",
      "event": "평가 종료 사유",
      "precondition": "explicit_end || task_end || infrastructure_failure",
      "action": "종료 사유를 결과와 분리",
      "state_effect": "변화 없음",
      "cap": "세션당",
      "guard": "턴 제한·브라우저 중단을 자동 불합격 처리 금지"
    }
  ]
}
