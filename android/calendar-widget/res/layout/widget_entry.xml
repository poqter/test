<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center_vertical">
    <FrameLayout android:id="@+id/stripe" android:layout_width="2dp" android:layout_height="10dp"/>
    <TextView android:id="@+id/entry" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:gravity="center_vertical" android:paddingStart="2dp" android:singleLine="true" android:ellipsize="end"
        android:includeFontPadding="false" android:textSize="9sp" android:textColor="#234857"/>
</LinearLayout>
